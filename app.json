{
  "expo": {
    "name": "Yoshioka",
    "slug": "calander-noti",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/branding/bousu-calendar-logo-v2.png",
    "scheme": "calandernoti",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartcalendar.reminder"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEE9FF",
        "foregroundImage": "./assets/branding/bousu-calendar-foreground-v2.png",
        "monochromeImage": "./assets/branding/bousu-notification-icon-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smartcalendar.reminder",
      "versionCode": 4,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/bousu-calendar-logo-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/bousu-calendar-logo-v2.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F2FF"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/bousu-notification-icon-v2.png",
          "color": "#5B5BD6",
          "defaultChannel": "event-reminders"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af452c8b-0f57-478b-ad0c-ffc659024ab4"
      }
    },
    "owner": "yoshioka2219"
  }
}
